# Copy to .env and fill in. Leave .env absent or empty to run in SAMPLE_MODE (no services needed).

# Zetaris (data layer) - REST API of your Zetaris instance (reach a remote one over an SSH tunnel so it stays localhost)
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=your-zetaris-api-key

# Meterless Nightshift (primary AI provider), from Nightshift's Console. The NVIDIA key lives in Nightshift, never here.
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=your-nightshift-runtime-token
METERLESS_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Runtime behaviour
SAMPLE_MODE=false
LOG_LEVEL=INFO
PORT=8000

# Optional
COMPANIES_HOUSE_API_KEY=
VESTING_DAY=2027-04-01
CLIFF_WINDOW_DAYS=180
