# Copy to .env. As shipped it runs in SAMPLE_MODE: no services, no credentials, no network.
# For live mode, fill in the two keys below and set SAMPLE_MODE=false (see docs/LIVE_RUN.md).
# Placeholder values starting with "your-" are treated as unset, so they never switch on live mode.

# Zetaris (data layer) - REST API of your Zetaris instance (reach a remote one over an SSH tunnel so it stays localhost)
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=your-zetaris-api-key
# Optional: after scripts/zetaris/build_usl.py has built the Unified Semantic Layer, set this to
# lightning.metastore.vesting_day.west_surrey to make the agent read through it. Empty = query the
# three council sources directly.
ZETARIS_USL=

# Meterless Nightshift (primary AI provider), from Nightshift's Console. The NVIDIA key lives in Nightshift, never here.
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=your-nightshift-runtime-token
METERLESS_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Runtime behaviour (true = cached council data + template writer; false = live Zetaris + Nightshift)
SAMPLE_MODE=true
LOG_LEVEL=INFO
PORT=8000

# Optional
COMPANIES_HOUSE_API_KEY=
VESTING_DAY=2027-04-01
CLIFF_WINDOW_DAYS=180
